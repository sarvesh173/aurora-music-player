# Aurora Music Player — Arch Linux PKGBUILD
# Maintainer: Aurora Project
pkgname=aurora-music
pkgver=17.5.0
pkgrel=1
pkgdesc="Lightweight Material 3 music player with browse, equalizer, visualizer, agent CLI"
arch=('any')
url="https://github.com/aurora/aurora-music"
license=('MIT')
depends=('python-pyside6' 'python-mutagen' 'python-numpy' 'ffmpeg' 'yt-dlp')
optdepends=('python-mpris_server: MPRIS media-key support')
source=("aurora_player.py::file:///opt/aurora-music/aurora_player.py")
sha256sums=('SKIP')

package() {
    install -Dm644 "$srcdir/aurora_player.py" "$pkgdir/opt/aurora-music/aurora_player.py"
    install -Dm644 "icon-256.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/aurora-music.png"
    install -Dm644 "icon-512.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/aurora-music.png"
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/aurora-music" << 'LAUNCHER'
#!/usr/bin/env bash
export QT_AUTO_SCREEN_SCALE_FACTOR=1
exec python3 /opt/aurora-music/aurora_player.py "$@"
LAUNCHER
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/aurora-music.desktop" << 'DESKTOP'
[Desktop Entry]
Type=Application
Name=Aurora Music
GenericName=Music Player
Exec=aurora-music
Icon=aurora-music
Terminal=false
Categories=AudioVideo;Audio;Player;
DESKTOP
}
